{
  "expo": {
    "name": "packyo",
    "slug": "gopack-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "gopack-mobile",
      "com.googleusercontent.apps.107013969008-b0tr74s0pu8sb7eof11sroj2l3uang3h"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFBF8"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.gopacknow.app",
      "associatedDomains": [
        "applinks:packyo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.gopacknow.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
       [
         "expo-image-picker",
         {
           "photosPermission": "Allow Packyo to access your photos so you can choose a profile picture."
         }
       ],
       "expo-apple-authentication",
       [
         "expo-notifications",
         {
           "icon": "./assets/images/icon.png",
           "color": "#F15A3A"
         }
       ],
       [
         "expo-calendar",
         {
           "calendarPermission": "Allow Packyo to add your itinerary activities to your calendar."
         }
       ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "246de177-cc0e-49f6-9a96-5d088306ca39"
      }
    }
  }
}
